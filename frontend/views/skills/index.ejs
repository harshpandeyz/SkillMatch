<%- include('../partials/header', { title: 'Skills' }) %>
<%- include('../partials/navbar') %>

<main class="container">
  <section class="dashboard-head">
    <div>
      <p class="eyebrow">Course Catalogue</p>
      <h1>Explore skill courses</h1>
      <p class="muted">Filter the catalogue by domain, difficulty, and career relevance.</p>
    </div>
  </section>

  <% if (currentUser && currentUser.role === 'admin') { %>
    <section class="panel">
      <h2>Add skill</h2>

      <% if (errors && errors.length) { %>
        <div class="alert">
          <% errors.forEach(error => { %><p><%= error.msg %></p><% }) %>
        </div>
      <% } %>

      <form method="POST" action="/skills" class="skill-form">
        <label>Name
          <input name="name" value="<%= old.name || '' %>" required>
        </label>
        <label>Category
          <select name="categoryId" required>
            <option value="">Select</option>
            <% categories.forEach(category => { %>
              <option value="<%= category.id %>" <%= Number(old.categoryId) === category.id ? 'selected' : '' %>><%= category.name %></option>
            <% }) %>
          </select>
        </label>
        <label>Difficulty
          <select name="difficulty" required>
            <% ['Beginner', 'Intermediate', 'Advanced'].forEach(level => { %>
              <option value="<%= level %>" <%= old.difficulty === level ? 'selected' : '' %>><%= level %></option>
            <% }) %>
          </select>
        </label>
        <label class="wide">Resource URL
          <input name="resourceUrl" value="<%= old.resourceUrl || '' %>" placeholder="https://example.com/course">
        </label>
        <label class="wide">Description
          <textarea name="description" required><%= old.description || '' %></textarea>
        </label>
        <button type="submit">Add skill</button>
      </form>
    </section>
  <% } %>

  <section class="course-toolbar panel">
    <label>Search courses
      <input id="courseSearch" type="search" placeholder="Search Node.js, security, cloud...">
    </label>
    <label>Category
      <select id="categoryFilter">
        <option value="">All categories</option>
        <% categories.forEach(category => { %>
          <option value="<%= category.id %>"><%= category.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Difficulty
      <select id="difficultyFilter">
        <option value="">All levels</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
      </select>
    </label>
  </section>

  <section class="cards-grid">
    <% skills.forEach(skill => { %>
      <article class="card course-card" data-name="<%= skill.name.toLowerCase() %>" data-category="<%= skill.category_id %>" data-difficulty="<%= skill.difficulty.toLowerCase() %>">
        <div class="card-top">
          <p class="eyebrow"><%= skill.category_name %></p>
          <span class="badge badge-<%= skill.difficulty.toLowerCase() %>"><%= skill.difficulty %></span>
        </div>
        <h2><a href="/skills/<%= skill.id %>"><%= skill.name %></a></h2>
        <p><%= skill.description %></p>
        <div class="course-meta">
          <span><%= skill.difficulty === 'Advanced' ? 'Advanced track' : skill.difficulty === 'Intermediate' ? 'Core track' : 'Foundation track' %></span>
          <span><%= skill.category_name %></span>
        </div>
        <% if (skill.resource_url) { %>
          <a class="course-link" href="<%= skill.resource_url %>" target="_blank" rel="noreferrer">Open resource</a>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <div class="inline-actions">
            <a href="/skills/<%= skill.id %>/edit">Edit</a>
            <form method="POST" action="/skills/<%= skill.id %>?_method=DELETE">
              <button class="danger" type="submit">Delete</button>
            </form>
          </div>
        <% } %>
      </article>
    <% }) %>
  </section>
</main>

<%- include('../partials/footer') %>
