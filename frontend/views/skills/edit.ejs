<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<% const isEditing = !!(skill && skill.id); %>

<main class="container container--narrow" style="padding-top:var(--sp-8);padding-bottom:var(--sp-16)">
  <div class="card">
    <span class="section-label"><%= isEditing ? 'Edit skill' : 'Add new skill' %></span>
    <h1 style="font-size:1.4rem;font-weight:800;margin-bottom:var(--sp-6)"><%= isEditing ? 'Update: ' + skill.name : 'Add a new skill' %></h1>
    <% if (errors && errors.length) { %>
      <div class="alert alert--error" style="margin-bottom:var(--sp-5)"><% errors.forEach(e => { %><p><%= e.msg %></p><% }) %></div>
    <% } %>
    <form method="POST" action="<%= isEditing ? '/skills/' + skill.id + '?_method=PUT' : '/skills' %>" class="form-stack">
      <div class="form-group"><label for="skillName">Skill name</label><input id="skillName" class="form-control" name="name" value="<%= skill ? skill.name : '' %>" required></div>
      <div class="form-group">
        <label for="catSelect">Category</label>
        <select id="catSelect" class="form-control" name="categoryId" required>
          <option value="">Select category</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= (skill && skill.category_id === c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="diffSelect">Difficulty</label>
        <select id="diffSelect" class="form-control" name="difficulty" required>
          <% ['Beginner','Intermediate','Advanced'].forEach(d => { %>
            <option value="<%= d %>" <%= (skill && skill.difficulty === d) ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group"><label for="descArea">Description</label><textarea id="descArea" class="form-control" name="description" rows="4" required><%= skill ? skill.description : '' %></textarea></div>
      <div class="form-group"><label for="urlInput">Resource URL <span class="text-muted">(optional)</span></label><input id="urlInput" class="form-control" name="resourceUrl" type="url" value="<%= skill ? (skill.resource_url || '') : '' %>"></div>
      <div style="display:flex;gap:var(--sp-3);margin-top:var(--sp-2)"><button type="submit" class="btn btn--primary"><%= isEditing ? 'Update skill' : 'Create skill' %></button><a href="/skills" class="btn btn--outline">Cancel</a></div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
