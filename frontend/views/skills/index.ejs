<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top:var(--sp-8);padding-bottom:var(--sp-16)">
  <div class="page-header">
    <div>
      <span class="section-label">Catalogue</span>
      <h1>Skills Catalogue</h1>
      <p class="text-muted">Browse <%= skills.length %> skills across 13 categories.</p>
    </div>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/skills/new" class="btn btn--primary">Add skill</a>
    <% } %>
  </div>

  <div class="filter-bar">
    <input type="search" id="skillSearch" class="form-control filter-bar__search" placeholder="Search skills..." autocomplete="off">
    <select id="catFilter" class="form-control filter-bar__select">
      <option value="">All categories</option>
      <% const cats = [...new Set(skills.map(s => s.category_name))].sort(); cats.forEach(c => { %>
        <option value="<%= c %>"><%= c %></option>
      <% }) %>
    </select>
    <div class="filter-bar__diff" role="group" aria-label="Filter by difficulty">
      <button class="diff-btn diff-btn--active" data-diff="">All</button>
      <button class="diff-btn" data-diff="Beginner">Beginner</button>
      <button class="diff-btn" data-diff="Intermediate">Intermediate</button>
      <button class="diff-btn" data-diff="Advanced">Advanced</button>
    </div>
  </div>

  <p class="text-muted" id="skillCount" style="margin-bottom:var(--sp-5);font-size:0.875rem"><%= skills.length %> skills shown</p>

  <div class="grid-auto" id="skillGrid">
    <% skills.forEach(skill => { %>
      <article class="skill-card card card--hover" data-name="<%= skill.name.toLowerCase() %>" data-category="<%= skill.category_name %>" data-difficulty="<%= skill.difficulty %>">
        <div class="skill-card__top">
          <span class="badge badge--category"><%= skill.category_name %></span>
          <span class="badge badge--<%= skill.difficulty.toLowerCase() %>"><%= skill.difficulty %></span>
        </div>
        <h3 class="skill-card__name"><a href="/skills/<%= skill.id %>"><%= skill.name %></a></h3>
        <p class="skill-card__desc text-muted"><%= skill.description %></p>
        <div class="skill-card__footer">
          <% if (skill.resource_url) { %>
            <a href="<%= skill.resource_url %>" target="_blank" rel="noopener" class="skill-card__link">Study resource</a>
          <% } else { %><span></span><% } %>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <div class="skill-card__admin">
              <a href="/skills/<%= skill.id %>/edit" class="btn btn--outline btn--sm">Edit</a>
              <form method="POST" action="/skills/<%= skill.id %>?_method=DELETE" style="display:inline">
                <button type="submit" class="btn btn--danger btn--sm">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="empty-state" id="noResults" hidden>
    <div class="empty-state__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="21" cy="21" r="12"/><path d="m31 31 9 9"/><path d="M16 21h10"/></svg>
    </div>
    <p class="empty-state__title">No skills match your filter</p>
    <p class="text-muted">Try a different search term or clear the filters.</p>
  </div>
</main>

<%- include('../partials/footer') %>
