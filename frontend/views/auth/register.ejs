<%- include('../partials/header', { title: 'Register' }) %>

<div class="auth-layout">
  <div class="auth-panel auth-panel--left">
    <div class="auth-logo-big">SM</div>
    <h2>Join learners building structured skill profiles</h2>
    <ul>
      <li>Set your target career role</li>
      <li>Track skills across 13 categories</li>
      <li>Get a ranked, personalised study plan</li>
    </ul>
  </div>
  <div class="auth-panel auth-panel--right">
    <div class="auth-form-box">
      <h1>Create account</h1>
      <p class="subtitle">Start building your skill profile today</p>

      <% if (errors && errors.length) { %>
        <div class="alert alert--error">
          <% errors.forEach(e => { %><p><%= e.msg || e %></p><% }) %>
        </div>
      <% } %>

      <form method="POST" action="/auth/register" class="form-stack">
        <div class="form-group">
          <label for="name">Full name</label>
          <input id="name" class="form-control" type="text" name="name" value="<%= old.name || '' %>" required autocomplete="name" placeholder="Jane Smith">
        </div>
        <div class="form-group">
          <label for="email">Email address</label>
          <input id="email" class="form-control" type="email" name="email" value="<%= old.email || '' %>" required autocomplete="email" placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label for="targetRole">Target role <span class="text-muted">(optional)</span></label>
          <input id="targetRole" class="form-control" type="text" name="targetRole" value="<%= old.targetRole || '' %>" placeholder="e.g. Backend Developer">
        </div>
        <div class="form-group">
          <label for="regPassword">Password</label>
          <input id="regPassword" class="form-control" type="password" name="password" required autocomplete="new-password">
          <div class="pw-strength"><div class="pw-strength__bar" id="pwStrengthBar"></div></div>
          <p class="pw-strength__label text-muted" id="pwStrengthLabel"></p>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Create account</button>
      </form>

      <p class="auth-footer">Already registered? <a href="/auth/login">Sign in</a></p>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
