<%- include('../partials/header', { title: 'Sign in' }) %>

<div class="auth-layout">
  <div class="auth-panel auth-panel--left">
    <div class="auth-logo-big">SM</div>
    <h2>Your personalized learning path starts here</h2>
    <ul>
      <li>Profile-based recommendations</li>
      <li>Role-matched scoring engine</li>
      <li>Secure, session-backed auth</li>
    </ul>
  </div>
  <div class="auth-panel auth-panel--right">
    <div class="auth-form-box">
      <h1>Welcome back</h1>
      <p class="subtitle">Sign in to your SkillMatch account</p>

      <div class="demo-creds">
        <strong>Demo accounts</strong>
        <p>admin@skillmatch.local / admin123</p>
        <p>harsh@gmail.com / 123456</p>
      </div>

      <% if (errors && errors.length) { %>
        <div class="alert alert--error">
          <% errors.forEach(e => { %><p><%= e.msg || e %></p><% }) %>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="form-stack">
        <div class="form-group">
          <label for="email">Email address</label>
          <input id="email" class="form-control" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" class="form-control" type="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn--primary btn--full">Sign in</button>
      </form>

      <p class="auth-footer">Don't have an account? <a href="/auth/register">Create one</a></p>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
